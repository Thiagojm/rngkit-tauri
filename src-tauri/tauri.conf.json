{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RngKit",
  "version": "0.1.0",
  "identifier": "com.rngkit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RngKit",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Thiagojm",
    "copyright": "Copyright (c) 2026 Thiagojm",
    "category": "Utility",
    "shortDescription": "Collect entropy samples and create descriptive reports.",
    "longDescription": "Windows-first desktop application that collects fixed-size entropy samples from one selected BitBabbler, TrueRNG, RDSEED, or PseudoRNG source, records native sessions, and generates XLSX reports.",
    "homepage": "https://github.com/Thiagojm/rngkit-tauri",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
